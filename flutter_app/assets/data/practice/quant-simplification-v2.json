      "group": "Simplification",
      "question": "(18 + 6) × 4 − 60 ÷ 5 = ?",
      "options": [
        "80",
        "82",
        "84",
        "86",
        "88"
      ],
      "correct": 2,
      "solution": "Brackets first: 18+6 = 24; 24×4 = 96; 60÷5 = 12; 96 − 12 = 84.",
      "trick": "Clear the innermost bracket, then × and ÷, then −."
    },
