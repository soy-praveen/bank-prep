    {
      "id": "quant-simplification-v2-q001",
      "group": "Simplification",
      "question": "24 × 3 + 48 ÷ 6 − 15 = ?",
      "options": [
        "62",
        "65",
        "68",
        "60",
        "70"
      ],
      "correct": 1,
      "solution": "BODMAS: multiply/divide first — 24×3 = 72, 48÷6 = 8. Then 72 + 8 − 15 = 65.",
      "trick": "Resolve all × and ÷ into single numbers before touching + and −; then it is plain addition/subtraction."
    },
    {
      "id": "quant-simplification-v2-q002",
      "group": "Simplification",
      "question": "√576 + √729 = ?",
      "options": [
        "49",
        "50",
        "51",
        "53",
        "55"
      ],
      "correct": 2,
      "solution": "√576 = 24, √729 = 27. Sum = 51.",
      "trick": "Memorise perfect-square roots to 30² and cube roots to 20³. 24² = 576, 27² = 729 are staples."
    },
    {
      "id": "quant-simplification-v2-q003",
      "group": "Simplification",
      "question": "17² − 13² = ?",
      "options": [
        "110",
        "120",
        "130",
        "100",
        "115"
      ],
      "correct": 1,
      "solution": "a² − b² = (a+b)(a−b) = (17+13)(17−13) = 30 × 4 = 120.",
      "trick": "Never square each term; the difference-of-squares factorisation is far faster."
    },
    {
      "id": "quant-simplification-v2-q004",
      "group": "Simplification",
      "question": "12³ ÷ 8 = ?",
      "options": [
        "216",
        "212",
        "224",
        "208",
        "220"
      ],
      "correct": 0,
      "solution": "12³/8 = (12/2)³ = 6³ = 216.",
      "trick": "Since 8 = 2³, dividing a cube by 2³ just halves the base before cubing."
    },
    {
      "id": "quant-simplification-v2-q005",
      "group": "Simplification",
      "question": "(3/7) of 448 = ?",
      "options": [
        "182",
