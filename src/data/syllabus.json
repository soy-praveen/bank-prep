            { "slug": "phrase-replacement", "name": "Phrase Replacement", "priority": "medium", "note": "Idioms and phrase-level grammar." },
            { "slug": "match-the-columns", "name": "Match the Columns", "priority": "low", "note": "Connect sentence halves meaningfully." },
            { "slug": "para-completion", "name": "Para Completion", "priority": "low", "note": "Pick the sentence completing the paragraph." },
            { "slug": "word-usage", "name": "Word Usage / Word Swap", "priority": "medium", "note": "Correct usage of a word across sentences; swap misplaced words." },
            { "slug": "vocabulary", "name": "Vocabulary (Synonym / Antonym)", "priority": "medium", "note": "Often embedded in RC." },
