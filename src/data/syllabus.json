{
  "exam": "SBI PO",
  "patternVersion": "2025-26 (revised)",
  "notes": [
    "No sectional cut-offs in Prelims or Mains; selection weight: Mains 75%, Psychometric/GD/Interview 25% (final merit from Mains + Phase III).",
    "Negative marking: one-fourth of the marks assigned to the question, for every wrong answer in objective papers.",
    "Prelims is qualifying with enforced 20-minute sectional timers; you cannot move between sections freely.",
    "Mains English carries 40 questions for 20 marks (0.5 mark each); Data Analysis questions carry 2 marks each."
  ],
  "stages": [
    {
      "id": "prelims",
      "name": "Prelims (Phase I)",
      "pattern": {
        "totalQuestions": 100,
        "totalMarks": 100,
        "totalMinutes": 60,
        "sectionalTiming": true,
        "sections": [
          { "name": "English Language", "pool": "english", "questions": 40, "marks": 40, "minutes": 20 },
          { "name": "Quantitative Aptitude", "pool": "quant", "questions": 30, "marks": 30, "minutes": 20 },
          { "name": "Reasoning Ability", "pool": "reasoning", "questions": 30, "marks": 30, "minutes": 20 }
        ]
      },
      "syllabus": [
        {
          "section": "english",
          "name": "English Language",
          "topics": [
            { "slug": "reading-comprehension", "name": "Reading Comprehension", "priority": "high", "note": "8-10 Q. Economy, banking, social themes; includes vocab-in-context." },
            { "slug": "cloze-test", "name": "Cloze Test", "priority": "high", "note": "5-6 Q passages with blanks." },
            { "slug": "error-spotting", "name": "Error Spotting", "priority": "high", "note": "Grammar rules: subject-verb agreement, tenses, prepositions." },
            { "slug": "para-jumbles", "name": "Para Jumbles", "priority": "high", "note": "5 Q rearrangement sets." },
            { "slug": "fillers", "name": "Fillers (Single / Double)", "priority": "medium", "note": "Vocabulary + context fit." },
